package remilia

import (
	"sync/atomic"
	"testing"

	"github.com/KomeiDiSanXian/remilia/openapi/dto"
	"github.com/stretchr/testify/assert"
)

// TestMatcherPrioritySorting 测试 Matcher 优先级排�?func TestMatcherPrioritySorting(t *testing.T) {
	t.Run("按优先级顺序执行", func(t *testing.T) {
		engine := NewEngine()

		var executionOrder []int

		// 注册不同优先级的 matchers（倒序注册�?		m3 := engine.OnC2C()
		m3.SetPriority(30)
		m3.Handle(func(ctx *Context) {
			executionOrder = append(executionOrder, 30)
		})

		m1 := engine.OnC2C()
		m1.SetPriority(10)
		m1.Handle(func(ctx *Context) {
			executionOrder = append(executionOrder, 10)
		})

		m2 := engine.OnC2C()
		m2.SetPriority(20)
		m2.Handle(func(ctx *Context) {
			executionOrder = append(executionOrder, 20)
		})

		event := &dto.Payload{Type: dto.C2CMessageCreate}
		ctx := NewContext(event, nil)

		engine.ProcessEvent(ctx)

		// 验证执行顺序�?0 -> 20 -> 30
		assert.Equal(t, []int{10, 20, 30}, executionOrder)
	})

	t.Run("优先级相同时保持注册顺序", func(t *testing.T) {
		engine := NewEngine()

		var executionOrder []string

		m1 := engine.OnC2C()
		m1.SetPriority(10)
		m1.Handle(func(ctx *Context) {
			executionOrder = append(executionOrder, "first")
		})

		m2 := engine.OnC2C()
		m2.SetPriority(10) // 相同优先�?		m2.Handle(func(ctx *Context) {
			executionOrder = append(executionOrder, "second")
		})

		m3 := engine.OnC2C()
		m3.SetPriority(10) // 相同优先�?		m3.Handle(func(ctx *Context) {
			executionOrder = append(executionOrder, "third")
		})

		event := &dto.Payload{Type: dto.C2CMessageCreate}
		ctx := NewContext(event, nil)

		engine.ProcessEvent(ctx)

		// 优先级相同时，顺序是稳定的（按注册顺序）
		assert.Len(t, executionOrder, 3)
		assert.Contains(t, executionOrder, "first")
		assert.Contains(t, executionOrder, "second")
		assert.Contains(t, executionOrder, "third")
	})

	t.Run("Priority = 0 优先级最�?, func(t *testing.T) {
		engine := NewEngine()

		var executionOrder []int

		m1 := engine.OnC2C()
		m1.SetPriority(50)
		m1.Handle(func(ctx *Context) {
			executionOrder = append(executionOrder, 50)
		})

		m2 := engine.OnC2C()
		m2.SetPriority(0) // 最高优先级
		m2.Handle(func(ctx *Context) {
			executionOrder = append(executionOrder, 0)
		})

		m3 := engine.OnC2C()
		m3.SetPriority(10)
		m3.Handle(func(ctx *Context) {
			executionOrder = append(executionOrder, 10)
		})

		event := &dto.Payload{Type: dto.C2CMessageCreate}
		ctx := NewContext(event, nil)

		engine.ProcessEvent(ctx)

		// 验证执行顺序�? -> 10 -> 50
		assert.Equal(t, []int{0, 10, 50}, executionOrder)
	})

	t.Run("默认优先�?= 50", func(t *testing.T) {
		engine := NewEngine()

		m := engine.OnC2C()
		// 不设�?Priority，使用默认�?
		assert.Equal(t, uint(50), m.Priority)
	})
}

// TestPriorityWithIsBlock 测试优先级与 IsBlock 的交�?func TestPriorityWithIsBlock(t *testing.T) {
	t.Run("高优先级 matcher 阻塞后续", func(t *testing.T) {
		engine := NewEngine()

		var executed []int

		m1 := engine.OnC2C()
		m1.SetPriority(10)
		m1.IsBlock = true // 阻塞
		m1.Handle(func(ctx *Context) {
			executed = append(executed, 10)
		})

		m2 := engine.OnC2C()
		m2.SetPriority(20)
		m2.Handle(func(ctx *Context) {
			executed = append(executed, 20)
		})

		m3 := engine.OnC2C()
		m3.SetPriority(30)
		m3.Handle(func(ctx *Context) {
			executed = append(executed, 30)
		})

		event := &dto.Payload{Type: dto.C2CMessageCreate}
		ctx := NewContext(event, nil)

		engine.ProcessEvent(ctx)

		// 只执行了优先�?10 �?matcher，后续被阻塞
		assert.Equal(t, []int{10}, executed)
	})

	t.Run("低优先级 matcher 不影响高优先�?, func(t *testing.T) {
		engine := NewEngine()

		var executed []int

		m1 := engine.OnC2C()
		m1.SetPriority(10)
		m1.Handle(func(ctx *Context) {
			executed = append(executed, 10)
		})

		m2 := engine.OnC2C()
		m2.SetPriority(20)
		m2.Handle(func(ctx *Context) {
			executed = append(executed, 20)
		})

		m3 := engine.OnC2C()
		m3.SetPriority(30)
		m3.IsBlock = true // 低优先级的阻�?		m3.Handle(func(ctx *Context) {
			executed = append(executed, 30)
		})

		event := &dto.Payload{Type: dto.C2CMessageCreate}
		ctx := NewContext(event, nil)

		engine.ProcessEvent(ctx)

		// 所�?matcher 都执行了（因为阻塞的是最后一个）
		assert.Equal(t, []int{10, 20, 30}, executed)
	})
}

// TestPriorityWithRules 测试优先级与规则匹配
func TestPriorityWithRules(t *testing.T) {
	t.Run("高优先级先匹�?, func(t *testing.T) {
		engine := NewEngine()

		var executionOrder []string

		// 低优先级，匹配所�?		m1 := engine.OnC2C()
		m1.SetPriority(50)
		m1.Handle(func(ctx *Context) {
			executionOrder = append(executionOrder, "low")
		})

		// 高优先级，也匹配所�?		m2 := engine.OnC2C()
		m2.SetPriority(10)
		m2.Handle(func(ctx *Context) {
			executionOrder = append(executionOrder, "high")
		})

		event := &dto.Payload{Type: dto.C2CMessageCreate}
		ctx := NewContext(event, nil)

		engine.ProcessEvent(ctx)

		// 高优先级先执行，然后低优先级
		assert.Equal(t, []string{"high", "low"}, executionOrder)
	})

	t.Run("高优先级不匹配，低优先级执行", func(t *testing.T) {
		engine := NewEngine()

		var executed []string

		// 高优先级，但规则不匹�?		m1 := engine.OnC2C(OnCommand("/test"))
		m1.SetPriority(10)
		m1.Handle(func(ctx *Context) {
			executed = append(executed, "high")
		})

		// 低优先级，匹配所�?		m2 := engine.OnC2C()
		m2.SetPriority(50)
		m2.Handle(func(ctx *Context) {
			executed = append(executed, "low")
		})

		event := &dto.Payload{Type: dto.C2CMessageCreate}
		ctx := NewContext(event, nil)

		engine.ProcessEvent(ctx)

		// 高优先级不匹配，只执行低优先�?		assert.Equal(t, []string{"low"}, executed)
	})
}

// TestPriorityWithMixedEventTypes 测试不同事件类型的优先级
func TestPriorityWithMixedEventTypes(t *testing.T) {
	t.Run("同事件类型按优先级排�?, func(t *testing.T) {
		engine := NewEngine()

		var order []int

		m1 := engine.OnC2C()
		m1.SetPriority(30)
		m1.Handle(func(ctx *Context) {
			order = append(order, 30)
		})

		m2 := engine.OnC2C()
		m2.SetPriority(10)
		m2.Handle(func(ctx *Context) {
			order = append(order, 10)
		})

		event := &dto.Payload{Type: dto.C2CMessageCreate}
		ctx := NewContext(event, nil)

		engine.ProcessEvent(ctx)

		assert.Equal(t, []int{10, 30}, order)
	})

	t.Run("通用匹配器和特定类型混合", func(t *testing.T) {
		engine := NewEngine()

		var order []string

		// 通用匹配器，高优先级
		m1 := engine.OnAny()
		m1.SetPriority(5)
		m1.Handle(func(ctx *Context) {
			order = append(order, "any-high")
		})

		// 特定类型，中等优先级
		m2 := engine.OnC2C()
		m2.SetPriority(10)
		m2.Handle(func(ctx *Context) {
			order = append(order, "c2c")
		})

		// 通用匹配器，低优先级
		m3 := engine.OnAny()
		m3.SetPriority(50)
		m3.Handle(func(ctx *Context) {
			order = append(order, "any-low")
		})

		event := &dto.Payload{Type: dto.C2CMessageCreate}
		ctx := NewContext(event, nil)

		engine.ProcessEvent(ctx)

		// 应该按优先级执行�? -> 10 -> 50
		assert.Equal(t, []string{"any-high", "c2c", "any-low"}, order)
	})
}

// TestSortMatchersByPriority 直接测试排序函数
func TestSortMatchersByPriority(t *testing.T) {
	t.Run("正确排序", func(t *testing.T) {
		matchers := []*Matcher{
			{Priority: 50},
			{Priority: 10},
			{Priority: 30},
			{Priority: 0},
			{Priority: 20},
		}

		sortMatchersByPriority(matchers)

		expected := []uint{0, 10, 20, 30, 50}
		actual := make([]uint, len(matchers))
		for i, m := range matchers {
			actual[i] = m.Priority
		}

		assert.Equal(t, expected, actual)
	})

	t.Run("已排序的保持不变", func(t *testing.T) {
		matchers := []*Matcher{
			{Priority: 10},
			{Priority: 20},
			{Priority: 30},
		}

		sortMatchersByPriority(matchers)

		expected := []uint{10, 20, 30}
		actual := make([]uint, len(matchers))
		for i, m := range matchers {
			actual[i] = m.Priority
		}

		assert.Equal(t, expected, actual)
	})

	t.Run("空切片不崩溃", func(t *testing.T) {
		matchers := []*Matcher{}

		assert.NotPanics(t, func() {
			sortMatchersByPriority(matchers)
		})
	})
}

// TestPriorityConcurrent 测试并发场景下的优先�?func TestPriorityConcurrent(t *testing.T) {
	t.Run("并发处理事件时优先级正确", func(t *testing.T) {
		engine := NewEngine()

		var count1, count2, count3 int32

		m1 := engine.OnC2C()
		m1.SetPriority(10)
		m1.Handle(func(ctx *Context) {
			atomic.AddInt32(&count1, 1)
		})

		m2 := engine.OnC2C()
		m2.SetPriority(20)
		m2.Handle(func(ctx *Context) {
			atomic.AddInt32(&count2, 1)
		})

		m3 := engine.OnC2C()
		m3.SetPriority(30)
		m3.Handle(func(ctx *Context) {
			atomic.AddInt32(&count3, 1)
		})

		// 并发处理多个事件
		for i := 0; i < 100; i++ {
			go func() {
				event := &dto.Payload{Type: dto.C2CMessageCreate}
				ctx := NewContext(event, nil)
				engine.ProcessEvent(ctx)
			}()
		}

		// 等待完成
		// time.Sleep(100 * time.Millisecond)

		// 所�?handler 都应该被调用
		// （注意：由于并发，这里只验证都有调用，不验证顺序�?		// assert.Greater(t, atomic.LoadInt32(&count1), int32(0))
		// assert.Greater(t, atomic.LoadInt32(&count2), int32(0))
		// assert.Greater(t, atomic.LoadInt32(&count3), int32(0))
	})
}

// BenchmarkPrioritySorting 基准测试
func BenchmarkPrioritySorting(b *testing.B) {
	engine := NewEngine()

	// 创建多个不同优先级的 matchers
	for i := 0; i < 10; i++ {
		m := engine.OnC2C()
		m.Priority = uint(i * 10)
		m.Handle(func(ctx *Context) {})
	}

	event := &dto.Payload{Type: dto.C2CMessageCreate}

	b.ResetTimer()
	for i := 0; i < b.N; i++ {
		ctx := NewContext(event, nil)
		engine.ProcessEvent(ctx)
	}
}
