# QQ机器人配置
BOT_APPID=你的机器人AppID
BOT_TOKEN=你的机器人Token

# 管理员用户ID（可选）
# 如果设置，该用户将拥有所有 debug 权限
# 如果不设置，Debug 插件将处于开发模式，允许所有用户使用
ADMIN_USER_ID=

# 使用说明：
# 1. 复制此文件为 .env
# 2. 填写你的机器人 AppID 和 Token
# 3. （可选）填写管理员用户ID
# 4. 在 PowerShell 中加载环境变量：
#    Get-Content .env | ForEach-Object {
#        if ($_ -match '^([^#].+?)=(.*)$') {
#            [System.Environment]::SetEnvironmentVariable($matches[1], $matches[2], "Process")
#        }
#    }
# 5. 运行: .\run.ps1

