package remilia

import (
	"fmt"
	"sync/atomic"
	"testing"

	"github.com/KomeiDiSanXian/remilia/openapi/dto"
	"github.com/stretchr/testify/assert"
)

// TestMatcherIndex 测试匹配器索引基本功能
func TestMatcherIndex(t *testing.T) {
	engine := NewEngine()
	assert.NotNil(t, engine.matcherIndex, "索引应该被初始化")

	var c2cCount, groupCount int64

	// 注册不同类型的匹配器，使用 Engine.OnC2C/OnGroupAt 方法
	engine.OnC2C().Handle(func(ctx *Context) {
		atomic.AddInt64(&c2cCount, 1)
	})

	engine.OnGroupAt().Handle(func(ctx *Context) {
		atomic.AddInt64(&groupCount, 1)
	})

	// 验证索引被正确建立
	assert.Greater(t, len(engine.matcherIndex), 0, "应该有索引条目")

	// 处理 C2C 事件
	c2cEvent := &dto.Payload{Type: dto.C2CMessageCreate}
	c2cCtx := NewContext(c2cEvent, nil)
	engine.ProcessEvent(c2cCtx)

	// 处理群聊事件
	groupEvent := &dto.Payload{Type: dto.GroupAtMessageCreate}
	groupCtx := NewContext(groupEvent, nil)
	engine.ProcessEvent(groupCtx)

	// 验证只有相关的匹配器被执行
	assert.Equal(t, int64(1), c2cCount)
	assert.Equal(t, int64(1), groupCount)
}

// TestMatcherIndexAlwaysEnabled 测试索引始终启用
func TestMatcherIndexAlwaysEnabled(t *testing.T) {
	engine := NewEngine()

	var count int64
	engine.OnC2C().Handle(func(ctx *Context) {
		atomic.AddInt64(&count, 1)
	})

	// 验证索引已建立
	assert.NotEmpty(t, engine.matcherIndex[dto.C2CMessageCreate], "C2C消息索引应该已建立")

	event := &dto.Payload{Type: dto.C2CMessageCreate}
	ctx := NewContext(event, nil)
	engine.ProcessEvent(ctx)

	assert.Equal(t, int64(1), count)
}

// TestMatcherIndexMultipleTypes 测试多种事件类型
func TestMatcherIndexMultipleTypes(t *testing.T) {
	engine := NewEngine()

	counts := make(map[string]*int64)
	eventTypes := []struct {
		name      string
		register  func() // 用于注册匹配器
		eventType dto.EventType
	}{
		{"C2C", func() { engine.OnC2C().Handle(func(ctx *Context) { atomic.AddInt64(counts["C2C"], 1) }) }, dto.C2CMessageCreate},
		{"GroupAt", func() { engine.OnGroupAt().Handle(func(ctx *Context) { atomic.AddInt64(counts["GroupAt"], 1) }) }, dto.GroupAtMessageCreate},
		{"GroupAdd", func() { engine.OnGroupAdd().Handle(func(ctx *Context) { atomic.AddInt64(counts["GroupAdd"], 1) }) }, dto.GroupAddRobot},
		{"GroupDel", func() { engine.OnGroupDel().Handle(func(ctx *Context) { atomic.AddInt64(counts["GroupDel"], 1) }) }, dto.GroupDelRobot},
	}

	// 初始化计数器
	for _, et := range eventTypes {
		var c int64
		counts[et.name] = &c
	}

	// 注册所有类型
	for _, et := range eventTypes {
		et.register()
	}

	// 测试每种类型
	for _, et := range eventTypes {
		event := &dto.Payload{Type: et.eventType}
		ctx := NewContext(event, nil)
		engine.ProcessEvent(ctx)

		// 只有对应的计数器应该增加
		for name, count := range counts {
			if name == et.name {
				assert.Equal(t, int64(1), atomic.LoadInt64(count),
					fmt.Sprintf("%s 应该被触发", name))
			} else {
				assert.Equal(t, int64(0), atomic.LoadInt64(count),
					fmt.Sprintf("%s 不应该被触发", name))
			}
		}

		// 重置计数器
		for _, count := range counts {
			atomic.StoreInt64(count, 0)
		}
	}
}

// TestMatcherIndexGenericRule 测试通用规则
func TestMatcherIndexGenericRule(t *testing.T) {
	engine := NewEngine()

	var genericCount, specificCount int64

	// 通用规则（适用于所有事件）
	engine.OnAny(func(ctx *Context) bool {
		return true // 总是匹配
	}).Handle(func(ctx *Context) {
		atomic.AddInt64(&genericCount, 1)
	})

	// 特定规则
	engine.OnC2C().Handle(func(ctx *Context) {
		atomic.AddInt64(&specificCount, 1)
	})

	// C2C 事件应该触发两个处理器
	c2cEvent := &dto.Payload{Type: dto.C2CMessageCreate}
	c2cCtx := NewContext(c2cEvent, nil)
	engine.ProcessEvent(c2cCtx)

	assert.Equal(t, int64(1), genericCount, "通用规则应该被触发")
	assert.Equal(t, int64(1), specificCount, "特定规则应该被触发")

	// 重置
	atomic.StoreInt64(&genericCount, 0)
	atomic.StoreInt64(&specificCount, 0)

	// 群聊事件应该只触发通用规则
	groupEvent := &dto.Payload{Type: dto.GroupAtMessageCreate}
	groupCtx := NewContext(groupEvent, nil)
	engine.ProcessEvent(groupCtx)

	assert.Equal(t, int64(1), genericCount, "通用规则应该被触发")
	assert.Equal(t, int64(0), specificCount, "特定规则不应该被触发")
}

// TestMatcherIndexPerformance 测试索引性能提升
func TestMatcherIndexPerformance(t *testing.T) {
	// 这个测试验证索引确实减少了检查次数
	engine := NewEngine()

	var checkCount int64

	// 注册30个不同类型的匹配器
	for i := 0; i < 10; i++ {
		engine.OnC2C().Handle(func(ctx *Context) {
			atomic.AddInt64(&checkCount, 1)
		})
		engine.OnGroupAt().Handle(func(ctx *Context) {
			atomic.AddInt64(&checkCount, 1)
		})
		engine.OnGroupAdd().Handle(func(ctx *Context) {
			atomic.AddInt64(&checkCount, 1)
		})
	}

	// 处理一个 C2C 事件
	event := &dto.Payload{Type: dto.C2CMessageCreate}
	ctx := NewContext(event, nil)
	engine.ProcessEvent(ctx)

	// 只有 C2C 的 10 个匹配器被触发
	assert.Equal(t, int64(10), checkCount,
		"索引应该只检查相关的匹配器")
}

// TestMatcherIndexBatchProcessing 测试批量处理中的索引
func TestMatcherIndexBatchProcessing(t *testing.T) {
	engine := NewEngine()

	var c2cCount, groupCount int64

	engine.OnC2C().Handle(func(ctx *Context) {
		atomic.AddInt64(&c2cCount, 1)
	})

	engine.OnGroupAt().Handle(func(ctx *Context) {
		atomic.AddInt64(&groupCount, 1)
	})

	// 混合事件批量处理
	events := []*dto.Payload{
		{Type: dto.C2CMessageCreate},
		{Type: dto.GroupAtMessageCreate},
		{Type: dto.C2CMessageCreate},
		{Type: dto.GroupAtMessageCreate},
		{Type: dto.C2CMessageCreate},
	}

	engine.ProcessEventBatch(events, nil)

	assert.Equal(t, int64(3), c2cCount)
	assert.Equal(t, int64(2), groupCount)
}

// TestMatcherIndexAutomaticIndexing 测试自动索引功能
func TestMatcherIndexAutomaticIndexing(t *testing.T) {
	engine := NewEngine()

	// 注册各种类型的匹配器
	engine.OnC2C().Handle(func(ctx *Context) {})
	engine.OnGroupAt().Handle(func(ctx *Context) {})
	engine.OnGroupAdd().Handle(func(ctx *Context) {})

	// 验证索引已自动建立
	assert.NotEmpty(t, engine.matcherIndex[dto.C2CMessageCreate], "C2C消息索引应该已建立")
	assert.NotEmpty(t, engine.matcherIndex[dto.GroupAtMessageCreate], "群聊@消息索引应该已建立")
	assert.NotEmpty(t, engine.matcherIndex[dto.GroupAddRobot], "机器人加群索引应该已建立")

	// 验证总匹配器数量
	assert.Len(t, engine.matchers, 3, "应该有3个匹配器")

	// 测试索引工作正常
	var count int64
	engine.OnC2C().Handle(func(ctx *Context) {
		atomic.AddInt64(&count, 1)
	})

	event := &dto.Payload{Type: dto.C2CMessageCreate}
	ctx := NewContext(event, nil)
	engine.ProcessEvent(ctx)

	assert.Equal(t, int64(1), count, "索引应该正确路由事件")
}

// TestMatcherIndexConcurrent 测试并发场景下的索引
func TestMatcherIndexConcurrent(t *testing.T) {
	engine := NewEngine()

	var count int64

	// 注册多个匹配器
	for i := 0; i < 10; i++ {
		engine.OnC2C().Handle(func(ctx *Context) {
			atomic.AddInt64(&count, 1)
		})
	}

	// 并发处理事件
	done := make(chan bool, 100)
	for i := 0; i < 100; i++ {
		go func() {
			event := &dto.Payload{Type: dto.C2CMessageCreate}
			ctx := NewContext(event, nil)
			engine.ProcessEvent(ctx)
			done <- true
		}()
	}

	// 等待完成
	for i := 0; i < 100; i++ {
		<-done
	}

	assert.Equal(t, int64(1000), count, "并发处理应该正确")
}

// BenchmarkWithIndex 使用索引的基准测试（索引始终启用）
func BenchmarkWithIndex(b *testing.B) {
	engine := NewEngine()
	// 默认启用索引

	// 注册30个匹配器（10个C2C, 10个群聊, 10个机器人事件）
	for i := 0; i < 10; i++ {
		engine.OnC2C().Handle(func(ctx *Context) {})
		engine.OnGroupAt().Handle(func(ctx *Context) {})
		engine.OnGroupAdd().Handle(func(ctx *Context) {})
	}

	event := &dto.Payload{Type: dto.C2CMessageCreate}

	b.ResetTimer()
	for i := 0; i < b.N; i++ {
		ctx := NewContext(event, nil)
		engine.ProcessEvent(ctx)
	}
}

// BenchmarkIndexScaling 测试不同 Matcher 数量下的索引性能（索引始终启用）
func BenchmarkIndexScaling(b *testing.B) {
	sizes := []int{10, 30, 50, 100}

	for _, size := range sizes {
		b.Run(fmt.Sprintf("Matchers-%d", size), func(b *testing.B) {
			engine := NewEngine()

			// 平均分布到3种事件类型
			perType := size / 3
			for i := 0; i < perType; i++ {
				engine.OnC2C().Handle(func(ctx *Context) {})
				engine.OnGroupAt().Handle(func(ctx *Context) {})
				engine.OnGroupAdd().Handle(func(ctx *Context) {})
			}

			event := &dto.Payload{Type: dto.C2CMessageCreate}

			b.ResetTimer()
			for i := 0; i < b.N; i++ {
				ctx := NewContext(event, nil)
				engine.ProcessEvent(ctx)
			}
		})
	}
}

func TestMatcherIndex_Basic(t *testing.T) {
	engine := NewEngine()

	m1 := engine.OnC2C()
	m2 := engine.OnGroupAt()

	assert.Len(t, engine.matcherIndex[dto.C2CMessageCreate], 1)
	assert.Len(t, engine.matcherIndex[dto.GroupAtMessageCreate], 1)
	assert.Equal(t, m1, engine.matcherIndex[dto.C2CMessageCreate][0])
	assert.Equal(t, m2, engine.matcherIndex[dto.GroupAtMessageCreate][0])
}

func TestMatcherIndex_MultipleMatchers(t *testing.T) {
	engine := NewEngine()

	m1 := engine.OnC2C()
	m2 := engine.OnC2C()

	matchers := engine.matcherIndex[dto.C2CMessageCreate]
	assert.Len(t, matchers, 2)
	assert.Equal(t, m1, matchers[0])
	assert.Equal(t, m2, matchers[1])
}

func TestMatcherIndex_GetMatchersForEvent(t *testing.T) {
	engine := NewEngine()

	c2cMatcher := engine.OnC2C()
	groupMatcher := engine.OnGroupAt()
	genericMatcher := engine.OnAny()

	ctxC2C := NewContext(&dto.Payload{Type: dto.C2CMessageCreate}, nil)
	ctxGroup := NewContext(&dto.Payload{Type: dto.GroupAtMessageCreate}, nil)

	matchersC2C := engine.getMatchersForEvent(ctxC2C)
	matchersGroup := engine.getMatchersForEvent(ctxGroup)

	assert.Contains(t, matchersC2C, c2cMatcher)
	assert.Contains(t, matchersC2C, genericMatcher)
	assert.NotContains(t, matchersC2C, groupMatcher)

	assert.Contains(t, matchersGroup, groupMatcher)
	assert.Contains(t, matchersGroup, genericMatcher)
	assert.NotContains(t, matchersGroup, c2cMatcher)
}

func TestMatcherIndex_RebuildIndex(t *testing.T) {
	engine := NewEngine()

	cases := []struct {
		name      string
		setup     func()
		et        dto.EventType
		expectLen int
	}{
		{"C2C only", func() { engine.OnC2C() }, dto.C2CMessageCreate, 1},
		{"Group only", func() { engine.OnGroupAt() }, dto.GroupAtMessageCreate, 1},
	}

	for _, ca := range cases {
		engine.DeleteAllMatchers()
		ca.setup()
		engine.rebuildIndexLocked()
		assert.Len(t, engine.matcherIndex[ca.et], ca.expectLen, ca.name)
	}
}
